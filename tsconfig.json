{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "ES2022", "DOM"],
    "ignoreDeprecations": "5.0",
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*", "src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx"],
}
