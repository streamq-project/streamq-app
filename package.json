{
  "name": "streamq",
  "productName": "StreamQ",
  "version": "2.0.1",
  "description": "StreamQ - https://streamq.io",
  "main": ".vite/build/main.js",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [],
  "author": {
    "name": "StreamQ",
    "email": "support@streamq.io",
    "url": "https://github.com/streamq-project/streamq-app"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=21",
    "pnpm": ">=11"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:watch": "WATCH=true electron-forge start",
    "package": "electron-forge package",
    "make:dev": "electron-forge make",
    "make:prod": "electron-forge make --prod",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "native:build": "napi build --platform --no-const-enum --runtime-string-enum --release --cwd native --package-json-path ../package.json --output-dir dist",
    "native:build:debug": "napi build --platform --no-const-enum --runtime-string-enum --cwd native --package-json-path ../package.json --output-dir dist",
    "build:types": "dts-bundle-generator --no-check --project tsconfig.dts.json -o out/main-api.d.ts src/preload/main-api.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-base": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@felixrieseberg/electron-forge-maker-nsis": "^7.2.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@napi-rs/cli": "^3.7.4",
    "@sentry/electron": "^7.10.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/fast-redact": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "app-builder-lib": "^26.8.1",
    "builder-util": "^26.8.1",
    "dts-bundle-generator": "^9.5.1",
    "electron": "^43.2.0",
    "electron-reloader": "^1.2.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fs-extra": "^11.3.0",
    "js-yaml": "^4.1.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass-embedded": "^1.98.0",
    "ts-node": "^10.9.2",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-native": "^2.2.2"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "fast-redact": "^3.5.0",
    "i18next": "^25.8.20",
    "lowdb": "^7.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "source-map-support": "^0.5.21",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
